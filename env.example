# Firebase Web Client Configuration
FIREBASE_API_KEY=AIzaSy_TU_API_KEY_AQUI
FIREBASE_PROJECT_ID=tu-proyecto-firebase
FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
FIREBASE_STORAGE_BUCKET=tu-proyecto.firebasestorage.app
FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
FIREBASE_MESSAGING_SENDER_ID=000000000000

# Firebase Data Connect & Cloud SQL
DATA_CONNECT_SERVICE=sakurapp
DATA_CONNECT_LOCATION=us-east4
DATA_CONNECT_CONNECTOR=example
CLOUD_SQL_INSTANCE=sakurapp-fdc
CLOUD_SQL_DATABASE=fdcdb

# Configuración de Pruebas / Semilla
DEFAULT_USER_PASSWORD=Sakura.2026

